# KitVault environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API
# https://app.supabase.com/project/_/settings/api

# Project URL (e.g. https://abcdefghijklmno.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose in the browser; RLS protects your data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
